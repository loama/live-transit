# Postgres connection string. The local pglite server from the README:
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# Bearer token Vercel cron requests must send to /api/cron/*.
CRON_SECRET=change-me
# Optional: public site URL used in links and the sitemap.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
