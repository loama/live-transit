{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/prune",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/cron/webhooks",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "src/app/api/v1/stream/route.ts": {
      "memory": 512
    }
  }
}
